// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BUYER
}

enum Dimension {
  WEIGHT
  VOLUME
  COUNT
}

enum BaseUnit {
  g
  mL
  unit
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(BUYER)
  company      String?
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products   Product[]
  quotations Quotation[]

  @@map("users")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  casNumber   String?   @map("cas_number")
  description String?
  category    String
  grade       String
  purity      String?

  dimension   Dimension
  baseUnit    BaseUnit  @map("base_unit")

  pricePerBase Decimal  @map("price_per_base") @db.Decimal(15, 6)

  stockQty     Decimal  @default(0) @map("stock_qty") @db.Decimal(15, 4)

  minOrderQty  Decimal  @default(0) @map("min_order_qty") @db.Decimal(15, 4)

  reorderLevel Decimal  @default(0) @map("reorder_level") @db.Decimal(15, 4)

  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String    @map("created_by_id")

  quotationItems QuotationItem[]

  @@map("products")
}

model Quotation {
  id        String          @id @default(cuid())
  status    QuotationStatus @default(DRAFT)
  notes     String?

  adminNote String?         @map("admin_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer   User   @relation(fields: [buyerId], references: [id])
  buyerId String @map("buyer_id")

  items QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id String @id @default(cuid())

  orderedQtyBase Decimal @map("ordered_qty_base") @db.Decimal(15, 4)

  orderedUnit String @map("ordered_unit")

  orderedQtyDisplay Decimal @map("ordered_qty_display") @db.Decimal(15, 4)

  unitPriceSnap Decimal @map("unit_price_snap") @db.Decimal(15, 6)

  lineTotal Decimal @map("line_total") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String    @map("quotation_id")

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  @@map("quotation_items")
}